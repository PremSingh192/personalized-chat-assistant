<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Login - Chat Widget Platform</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-container {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 400px;
        }
        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .login-header h1 {
            color: #333;
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }
        .login-header p {
            color: #666;
            font-size: 0.9rem;
        }
        .form-group {
            margin-bottom: 1.5rem;
        }
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: #333;
            font-weight: 500;
        }
        .form-group input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
            transition: border-color 0.3s;
        }
        .form-group input:focus {
            outline: none;
            border-color: #4facfe;
        }
        .login-btn {
            width: 100%;
            padding: 0.75rem;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .login-btn:hover {
            transform: translateY(-2px);
        }
        .error {
            background: #fee;
            color: #c33;
            padding: 0.75rem;
            border-radius: 5px;
            margin-bottom: 1rem;
            border: 1px solid #fcc;
            font-size: 0.9rem;
        }
        
        /* Enhanced Responsive Design */
        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }
            
            .login-container {
                padding: 1.5rem;
                margin: 0;
                width: 100%;
                max-width: none;
                border-radius: 8px;
            }
            
            .login-header h1 {
                font-size: 1.6rem;
            }
            
            .login-header p {
                font-size: 0.85rem;
            }
            
            .form-group {
                margin-bottom: 1.25rem;
            }
            
            .form-group label {
                font-size: 0.9rem;
                margin-bottom: 0.4rem;
            }
            
            .form-group input {
                padding: 0.65rem;
                font-size: 1rem;
            }
            
            .login-btn {
                padding: 0.65rem;
                font-size: 0.95rem;
            }
        }
        
        @media (max-width: 576px) {
            body {
                padding: 0.5rem;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            
            .login-container {
                padding: 1.25rem;
                border-radius: 6px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            }
            
            .login-header {
                margin-bottom: 1.5rem;
                text-align: center;
            }
            
            .login-header h1 {
                font-size: 1.4rem;
                margin-bottom: 0.4rem;
            }
            
            .login-header p {
                font-size: 0.8rem;
                margin-bottom: 1.5rem;
            }
            
            .form-group {
                margin-bottom: 1rem;
            }
            
            .form-group label {
                font-size: 0.85rem;
                margin-bottom: 0.3rem;
            }
            
            .form-group input {
                padding: 0.6rem;
                font-size: 0.95rem;
                border-radius: 4px;
            }
            
            .login-btn {
                padding: 0.6rem;
                font-size: 0.9rem;
                border-radius: 4px;
            }
            
            .error {
                padding: 0.6rem;
                font-size: 0.85rem;
                margin-bottom: 0.75rem;
            }
        }
        
        @media (max-width: 480px) {
            body {
                padding: 0.25rem;
            }
            
            .login-container {
                padding: 1rem;
                border-radius: 4px;
                box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            }
            
            .login-header h1 {
                font-size: 1.3rem;
            }
            
            .login-header p {
                font-size: 0.75rem;
            }
            
            .form-group input {
                padding: 0.55rem;
                font-size: 0.9rem;
            }
            
            .login-btn {
                padding: 0.55rem;
                font-size: 0.85rem;
            }
        }
        
        @media (max-width: 360px) {
            .login-container {
                padding: 0.75rem;
            }
            
            .login-header h1 {
                font-size: 1.2rem;
            }
            
            .form-group input {
                padding: 0.5rem;
                font-size: 0.85rem;
            }
            
            .login-btn {
                padding: 0.5rem;
                font-size: 0.8rem;
            }
        }
        
        /* Landscape mobile optimizations */
        @media (max-height: 600px) and (orientation: landscape) {
            .login-container {
                margin: 1rem auto;
                max-height: 90vh;
                overflow-y: auto;
            }
            
            .login-header {
                margin-bottom: 1rem;
            }
            
            .login-header h1 {
                font-size: 1.3rem;
                margin-bottom: 0.3rem;
            }
            
            .login-header p {
                font-size: 0.8rem;
                margin-bottom: 1rem;
            }
            
            .form-group {
                margin-bottom: 0.75rem;
            }
            
            .form-group input {
                padding: 0.5rem;
                font-size: 0.9rem;
            }
            
            .login-btn {
                padding: 0.5rem;
                font-size: 0.85rem;
            }
        }
        
        /* High DPI displays */
        @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
            .login-container {
                box-shadow: 0 15px 35px rgba(0,0,0,0.12);
            }
            
            .form-group input:focus {
                box-shadow: 0 0 0 2px rgba(79, 172, 254, 0.2);
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>Business Login</h1>
            <p>Chat Widget Platform</p>
        </div>
        
        <% if (typeof error !== 'undefined') { %>
            <div class="error"><%= error %></div>
        <% } %>
        
        <form method="POST" action="/business/login">
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            </div>
            
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
            </div>
            
            <button type="submit" class="login-btn">Login</button>
        </form>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Widget Platform</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .landing-container {
            text-align: center;
            color: white;
            max-width: 600px;
            padding: 2rem;
        }
        .landing-header {
            margin-bottom: 3rem;
        }
        .landing-header h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }
        .landing-header p {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-bottom: 2rem;
        }
        .cta-button {
            background: white;
            color: #667eea;
            padding: 1rem 2rem;
            border: none;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }
        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        }
        .features {
            margin-top: 3rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
        }
        .feature {
            background: rgba(255,255,255,0.1);
            padding: 1.5rem;
            border-radius: 10px;
            backdrop-filter: blur(10px);
        }
        .feature h3 {
            margin-bottom: 0.5rem;
            font-size: 1.1rem;
        }
        .feature p {
            opacity: 0.8;
            font-size: 0.9rem;
        }
        
        /* Enhanced Responsive Design */
        @media (max-width: 992px) {
            .landing-container {
                max-width: 700px;
                padding: 1.5rem;
            }
            
            .landing-header h1 {
                font-size: 2.5rem;
            }
            
            .landing-header p {
                font-size: 1.1rem;
            }
            
            .features {
                grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
                gap: 1.5rem;
            }
            
            .feature {
                padding: 1.25rem;
            }
        }
        
        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }
            
            .landing-container {
                max-width: 100%;
                padding: 1rem;
            }
            
            .landing-header {
                margin-bottom: 2rem;
            }
            
            .landing-header h1 {
                font-size: 2.2rem;
                margin-bottom: 0.8rem;
            }
            
            .landing-header p {
                font-size: 1rem;
                margin-bottom: 1.5rem;
            }
            
            .cta-button {
                padding: 0.8rem 1.5rem;
                font-size: 1rem;
            }
            
            .features {
                margin-top: 2rem;
                grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
                gap: 1rem;
            }
            
            .feature {
                padding: 1rem;
            }
            
            .feature h3 {
                font-size: 1rem;
            }
            
            .feature p {
                font-size: 0.85rem;
            }
        }
        
        @media (max-width: 576px) {
            body {
                padding: 0.5rem;
            }
            
            .landing-container {
                padding: 0.75rem;
            }
            
            .landing-header {
                margin-bottom: 1.5rem;
            }
            
            .landing-header h1 {
                font-size: 1.8rem;
                margin-bottom: 0.6rem;
            }
            
            .landing-header p {
                font-size: 0.9rem;
                margin-bottom: 1.2rem;
            }
            
            .cta-button {
                padding: 0.7rem 1.2rem;
                font-size: 0.9rem;
            }
            
            .features {
                margin-top: 1.5rem;
                grid-template-columns: 1fr;
                gap: 0.75rem;
            }
            
            .feature {
                padding: 0.8rem;
            }
            
            .feature h3 {
                font-size: 0.95rem;
                margin-bottom: 0.4rem;
            }
            
            .feature p {
                font-size: 0.8rem;
            }
        }
        
        @media (max-width: 480px) {
            body {
                padding: 0.25rem;
            }
            
            .landing-container {
                padding: 0.5rem;
            }
            
            .landing-header h1 {
                font-size: 1.6rem;
            }
            
            .landing-header p {
                font-size: 0.85rem;
            }
            
            .cta-button {
                padding: 0.6rem 1rem;
                font-size: 0.85rem;
            }
            
            .feature {
                padding: 0.6rem;
            }
        }
        
        @media (max-width: 360px) {
            .landing-header h1 {
                font-size: 1.4rem;
            }
            
            .landing-header p {
                font-size: 0.8rem;
            }
            
            .cta-button {
                padding: 0.5rem 0.8rem;
                font-size: 0.8rem;
            }
            
            .feature {
                padding: 0.5rem;
            }
            
            .feature h3 {
                font-size: 0.9rem;
            }
            
            .feature p {
                font-size: 0.75rem;
            }
        }
        
        /* Landscape mobile optimizations */
        @media (max-height: 600px) and (orientation: landscape) {
            .landing-container {
                padding: 0.5rem;
            }
            
            .landing-header {
                margin-bottom: 1rem;
            }
            
            .landing-header h1 {
                font-size: 1.8rem;
                margin-bottom: 0.4rem;
            }
            
            .landing-header p {
                font-size: 0.9rem;
                margin-bottom: 1rem;
            }
            
            .cta-button {
                padding: 0.5rem 1rem;
                font-size: 0.9rem;
            }
            
            .features {
                margin-top: 1rem;
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 0.75rem;
            }
            
            .feature {
                padding: 0.6rem;
            }
        }
        
        /* High DPI displays */
        @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
            .cta-button {
                box-shadow: 0 12px 30px rgba(0,0,0,0.25);
            }
            
            .cta-button:hover {
                box-shadow: 0 18px 40px rgba(0,0,0,0.35);
            }
        }
    </style>
</head>
<body>
    <div class="landing-container">
        <div class="landing-header">
            <h1>Chat Widget Platform</h1>
            <p>Powerful AI-powered chat solutions for your business</p>
            <a href="/login" class="cta-button">Get Started</a>
        </div>
        
        <div class="features">
            <div class="feature">
                <h3>🤖 AI-Powered</h3>
                <p>Advanced AI responses for customer support</p>
            </div>
            <div class="feature">
                <h3>📊 Analytics</h3>
                <p>Detailed insights and conversation tracking</p>
            </div>
            <div class="feature">
                <h3>🎨 Customizable</h3>
                <p>Match your brand with custom styling</p>
            </div>
            <div class="feature">
                <h3>🔒 Secure</h3>
                <p>Enterprise-grade security and privacy</p>
            </div>
        </div>
    </div>
</body>
</html>
